node_modules/
dist/
*.env
.env
# *.env / .env only match a file literally ending in ".env" — they missed
# backend/.env.pre-migration (a full local .env snapshot with JWT_SECRET and
# SEED_ADMIN_PASSWORD in plaintext). .env.* catches any dotted variant;
# keep .env.example trackable since it's a template, not a secret.
.env.*
!.env.example
backend/node_modules/
frontend/node_modules/
backend/dist/

# local dev launcher runtime (pids + logs)
.crm/

# extension config holds the live AUTOMATION_API_KEY — see config.example.js
browser-extension/*/config.js
